@* Ornamentos em SVG próprios; a cor vem de "color" (currentColor) *@
<svg class="ornamento @Class" width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    @switch (Tipo)
    {
        case TipoOrnamento.Coracao:
            <path d="M12 20.5C6 16.3 2.5 13 2.5 9.2 2.5 6.6 4.5 4.5 7 4.5c1.9 0 3.6 1.1 5 3 1.4-1.9 3.1-3 5-3 2.5 0 4.5 2.1 4.5 4.7 0 3.8-3.5 7.1-9.5 11.3Z" />
            break;

        case TipoOrnamento.Estrela:
            <path d="M12 2Q13 11 22 12Q13 13 12 22Q11 13 2 12Q11 11 12 2Z" />
            break;

        case TipoOrnamento.Laco:
            <path d="M10.8 11C8.2 7.2 3 5.8 3 9.6S8.2 15.2 10.8 13.2Z" />
            <path d="M13.2 11C15.8 7.2 21 5.8 21 9.6S15.8 15.2 13.2 13.2Z" />
            <path d="M11 13.4 8.6 19.2l2.3-.7L12 14.2Z" />
            <path d="M13 13.4l2.4 5.8-2.3-.7L12 14.2Z" />
            <rect x="10.1" y="9.8" width="3.8" height="4.4" rx="1.6" />
            break;

        case TipoOrnamento.Caveira:
            @* olhos, nariz e dentinhos recortados com evenodd *@
            <path fill-rule="evenodd"
                  d="M12 3C7.6 3 4.5 6 4.5 10c0 2.4 1.1 4.2 2.8 5.2V18a1.5 1.5 0 0 0 1.5 1.5h6.4a1.5 1.5 0 0 0 1.5-1.5v-2.8c1.7-1 2.8-2.8 2.8-5.2C19.5 6 16.4 3 12 3ZM9 8.4a2 2 0 1 1 0 4 2 2 0 1 1 0-4Zm6 0a2 2 0 1 1 0 4 2 2 0 1 1 0-4ZM12 13.4l-.9 1.5h1.8ZM10.2 17h1.1v2.5h-1.1Zm2.5 0h1.1v2.5h-1.1Z" />
            break;
    }
</svg>

@code {
    [Parameter]
    public TipoOrnamento Tipo { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
