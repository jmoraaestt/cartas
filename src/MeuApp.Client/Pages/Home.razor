@page "/"

<PageTitle>MeuApp</PageTitle>

<div class="estado-vazio">
    <h1 class="titulo-pagina">
        <Ornamento Tipo="TipoOrnamento.Estrela" Class="ornamento--lilas" />
        Boas-vindas!
        <Ornamento Tipo="TipoOrnamento.Estrela" Class="ornamento--lilas" />
    </h1>
    <p>Escreva cartinhas, guarde rascunhos e publique quando estiverem prontas.</p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
