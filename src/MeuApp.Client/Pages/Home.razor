            <a href="escrever" class="btn btn-primary">
                <Ornamento Tipo="TipoOrnamento.Coracao" /> Escrever
            </a>
        </AuthorizeView>
        <a href="cartas" class="btn btn-outline-primary">Ler cartas</a>
    </div>
</div>
