@page "/escrever"
@page "/escrever/{Id:int}"
@attribute [Authorize(Roles = Papeis.Escritora)]
@using MeuApp.Shared
@inject HttpClient Http
@inject NavigationManager Nav

<div class="leitura">
    <h1 class="titulo-pagina mb-3">
        <Ornamento Tipo="TipoOrnamento.Laco" Class="ornamento--rosa" />
        @(Id is null ? "Escrever carta" : "Editar carta")
    </h1>

    @if (erro is not null)
    {
        <div class="alert alert-danger">@erro</div>
    }

    @if (publicada)
    {
        <div class="alert alert-info">
            Esta carta já foi publicada e não pode mais ser editada.
            <a href="cartas/@Id">Ler carta</a>
        </div>
    }
    else
    {
        <EditForm Model="carta" OnValidSubmit="Salvar" class="papel-carta">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="titulo">Título</label>
                <InputText id="titulo" class="form-control" @bind-Value="carta.Titulo" />
                <ValidationMessage For="() => carta.Titulo" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="conteudo">Carta</label>
                <InputTextArea id="conteudo" class="form-control texto-pautado" rows="12" @bind-Value="carta.Conteudo" />
                <ValidationMessage For="() => carta.Conteudo" />
            </div>

            <div>
                <button class="btn btn-primary" disabled="@salvando">Salvar rascunho</button>
            </div>
        </EditForm>
    }
</div>


@code {

    [Parameter]
    public int? Id { get; set; }

    private NovaCartaDto carta = new();
    private bool salvando;
    private bool publicada;   // carta já publicada: só leitura, sem formulário
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        if (Id is null)
        {
            carta = new();
            return;
        }

        try
        {
            var existente = await Http.GetFromJsonAsync<Carta>($"api/cartas/{Id}");
            if (existente!.Publicada)
            {
                publicada = true;
                return;
            }

            carta = new NovaCartaDto
            {
                Titulo = existente.Titulo,
                Conteudo = existente.Conteudo
            };
        }
        catch (Exception)
        {
            erro = "Carta não encontrada.";
        }
    }
    private async Task Salvar()
    {
        salvando = true;
        erro = null;

        try
        {
            var resposta = Id is null
                ? await Http.PostAsJsonAsync("api/cartas", carta)
                : await Http.PutAsJsonAsync($"api/cartas/{Id}", carta);

            if (resposta.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/rascunhos");
            }
            else
            {
                erro = await resposta.Content.ReadAsStringAsync();
            }
        }
        catch (HttpRequestException)
        {
            erro = "Não foi possível conectar ao servidor.";
        }
        finally
        {
            salvando = false;
        }
    }
}
